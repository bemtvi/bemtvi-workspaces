{
  "setup": {
    "require": "workspace-setup.python",
    "method": "venv",
    "params": { "dir": ".venv" }
  },
  "languages": {
    "python": {
      "lsps": {
        "pyright": {},
        "ruff": { "cmd": ["ruff", "server"], "filetypes": ["python"] }
      },
      "save_actions": [
        {
          "require": "nx.lsp",
          "method": "code_action",
          "params": { "context": { "only": ["source.fixAll"] }, "apply": true }
        },
        { "require": "nx.lsp", "method": "format", "params": { "name": "ruff" } }
      ],
      "settings": { "tabstop": 4, "shiftwidth": 4, "expandtab": true }
    }
  }
}
